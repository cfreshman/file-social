# Use this .gitignore if you want to track ONLY your content, not the core app
# Used by 'npm run eject'

# Ignore everything by default
*

# Allow these directories (must un-ignore parent dirs first)
!posts/
!posts/**

!public/
!public/config/
!public/config/**
!public/data/
!public/data/**

!server/
!server/custom/
!server/custom/**

!deploy/
!deploy/config.sh

# Allow .gitignore itself
!.gitignore

